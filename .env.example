# Copy this file to .env and fill in the values.
# .env is listed in .gitignore, so your real values are never committed.

# Required: a free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Required for the chat page: any password you choose.
APP_PASSWORD=choose_a_password

# Optional: turns on web search. A free key from https://tavily.com
# TAVILY_API_KEY=your_tavily_api_key

# Optional: the models used. These are the defaults.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Optional: questions allowed per visit to the chat page.
# MAX_QUESTIONS=20

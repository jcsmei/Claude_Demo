# Secrets (API keys, passwords) - never commit
.env
.streamlit/secrets.toml

# Virtual environment - recreate with: python -m venv .venv
.venv/

# Local-only copy of the C4 version of the architecture diagrams
docs/architecture_levels.md

# Personal Claude Code settings for this machine
.claude/settings.local.json

# Chroma database - rebuilt from data/ by running: python -m assistant.rag
chroma_db/

# Log files written by the MCP server
logs/

# Python's auto-generated compiled files
__pycache__/

# Private working journal and transcript archive - local only
journal/
